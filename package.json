{
  "name": "cribbage-animation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run server/dev.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "start": "bun run server/start.ts",
    "test:unit": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:firebase": "firebase emulators:exec --project demo-cribbage --only firestore \"bun test tests/firebase\"",
    "music:compose": "bun scripts/compose-music.ts",
    "music:render": "bun scripts/render-music.ts"
  },
  "dependencies": {
    "@threlte/core": "8.5.16",
    "@threlte/extras": "9.23.0",
    "firebase": "12.16.0",
    "svelte": "5.55.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.0",
    "@types/bun": "^1.4.4",
    "@types/three": "0.185.4",
    "firebase-tools": "15.25.0",
    "sharp": "^0.35.5",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "license": "GPL-3.0-only"
}
